<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <RootNamespace>TheUtils</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <!-- NuGet Package Metadata -->
    <PackageVersion>1.0.0-beta</PackageVersion>
    <Title>Postgres Extensions for TheUtils.Db</Title>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Description>Postgres-specific extensions for TheUtils.Db including COPY protocol, LISTEN/NOTIFY, advisory locks, and JSONB support.</Description>
    <PackageProjectUrl>https://github.com/kirill-gerasimenko-da/the-utils</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kirill-gerasimenko-da/the-utils</RepositoryUrl>
    <Authors>Kirill Gerasimenko</Authors>
    <PackageTags>postgres;postgresql;monad;functional;language-ext;ef-core;npgsql</PackageTags>
    <PackageId>TheUtils.Db.Postgres</PackageId>
    <Product>TheUtils.Db.Postgres</Product>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TheUtils.Db/TheUtils.Db.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
